// Cloudflare Workers config for hackthetoon.com.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hack-the-toon",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
