# Files in the repo that must not be served as part of the website
.git
.gitignore
.assetsignore
.dev.vars
.dev.vars.example
.wrangler
node_modules
src
supabase
README.md
wrangler.jsonc

# Full-size originals of the commissioned paintings; the site serves the
# optimised copies in assets/img
assets/Images

# SVG sources of the large watercolour textures; the site serves the WebP
# renders of them in assets/texture
assets/texture/src

# Their images in assets/email are served by the site, so they stay deployed.
/email
